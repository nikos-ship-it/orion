# Apache config. Plesk usually runs nginx in front of Apache — if "Smart static
# files processing" is on, nginx serves static files itself and NEVER reads this
# file. See plesk-nginx.conf for the equivalent rules to paste into
# Plesk → Apache & nginx Settings → Additional nginx directives.

# This deploys into /orionouzeri.gr, which still holds the old WordPress install.
# Plesk's git deploy writes repo files but does not delete untracked ones, so
# WordPress's index.php survives the deploy and would otherwise be served ahead
# of our index.html. Pin the order explicitly.
DirectoryIndex index.html

ErrorDocument 404 /404.html

# ── Don't serve leftovers ─────────────────────────────────────────
# If PHP is ever disabled for this domain, .php files get served as PLAIN TEXT
# and wp-config.php would leak the database credentials. Deleting the old
# WordPress files is the real fix; this is a safety net until then.
<FilesMatch "^(wp-config\.php|wp-config-sample\.php|readme\.html|license\.txt)$">
  Require all denied
</FilesMatch>

# README.md ships with the site but is not for visitors.
<FilesMatch "\.(md|yml|yaml)$">
  Require all denied
</FilesMatch>

# Never expose a repository directory if one ends up in the docroot.
RedirectMatch 404 /\.git

# ── Compression ──────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Already-compressed formats: don't waste CPU re-compressing.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|mp4|woff2)$">
    Header unset Content-Encoding
  </FilesMatch>
</IfModule>

# ── Caching ──────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  # One day, not one month. index.html carries ?v=N on every stylesheet and
  # script, which is what actually busts these — but if a deploy ever ships
  # without bumping it, a stale copy must expire in a day, not in a month. That
  # mismatch once left a phone pairing new HTML with a month-old script.js.
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  # HTML stays uncached so edits appear immediately.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── Security headers ─────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # SAMEORIGIN, not DENY: the Visit section embeds map.html in an iframe.
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Correct MIME types ───────────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType application/manifest+json .webmanifest
</IfModule>

# ── HTTPS and www canonicalisation ───────────────────────────────
# Left commented on purpose: Plesk handles both under Hosting Settings
# ("Permanent SEO-safe 301 redirect from HTTP to HTTPS"), and doubling it up
# behind the nginx proxy is the classic cause of redirect loops. Prefer the
# Plesk checkbox over these rules.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
#   RewriteCond %{HTTP_HOST} ^www\.orionouzeri\.gr$ [NC]
#   RewriteRule ^(.*)$ https://orionouzeri.gr/$1 [R=301,L]
# </IfModule>
