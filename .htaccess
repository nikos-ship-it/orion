# Apache / LiteSpeed config (top.host, cPanel, DirectAdmin).
# Netlify and Cloudflare Pages ignore this file — they read _headers instead.
#
# IMPORTANT: an .htaccess in the document root also applies to every
# subdirectory beneath it. If a subdomain's document root lives inside this
# folder (e.g. public_html/menu/), these rules will apply to it too. Check the
# subdomain's document root in your hosting panel before deploying.

ErrorDocument 404 /404.html

# ── Compression ──────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Already-compressed formats: don't waste CPU re-compressing.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|mp4|woff2)$">
    Header unset Content-Encoding
  </FilesMatch>
</IfModule>

# ── Caching ──────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  # HTML stays uncached so edits appear immediately.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── Security headers ─────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # SAMEORIGIN, not DENY: the Visit section embeds map.html in an iframe.
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Correct MIME types ───────────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType application/manifest+json .webmanifest
</IfModule>

# ── HTTPS and www canonicalisation ───────────────────────────────
# Left commented on purpose: most hosts (including cPanel with AutoSSL) already
# force HTTPS at a layer above this, and doubling it up behind a proxy is the
# classic cause of redirect loops. Enable ONE of these only after confirming
# your host is not already redirecting.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
#   RewriteCond %{HTTP_HOST} ^www\.orionouzeri\.gr$ [NC]
#   RewriteRule ^(.*)$ https://orionouzeri.gr/$1 [R=301,L]
# </IfModule>
