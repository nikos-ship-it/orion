# Netlify / Cloudflare Pages header rules. Ignored by Apache — see .htaccess.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Filenames are stable, so revalidating costs a round trip for nothing.
# If you replace a photo, change its filename or add a ?v= query.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must never be cached hard, or edits take a year to appear.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
